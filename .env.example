# Postgres connection string (Neon / Supabase / Vercel Postgres).
# Leave empty locally to store leads in .data/leads.json instead.
DATABASE_URL=

# Password for the /admin leads dashboard (defaults to "cynbit-demo" if unset).
ADMIN_PASSWORD=cynbit-demo

# Secret used to sign the admin session cookie. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
